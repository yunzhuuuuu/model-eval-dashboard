# Shared database configured through a Vercel Marketplace Postgres provider.
DATABASE_URL=

# Private Vercel Blob token. Keep this server-side only.
BLOB_READ_WRITE_TOKEN=

# Gemini credential used only by the Python worker.
GEMINI_API_KEY=

# Optional worker tuning.
WORKER_LEASE_SECONDS=900
WORKER_RETRY_DELAY_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_CLEANUP_BATCH_SIZE=100
WORKER_MAX_UPLOAD_BYTES=10485760
WORKER_MAX_CONTEXTS=10000
WORKER_MAX_QUESTIONS=10000
